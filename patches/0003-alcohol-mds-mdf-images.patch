+// Alcohol 120% images (.mds + .mdf). The .mds is only a descriptor; the
+// sectors live in the .mdf beside it. DVD images - every commercial NUON disc -
+// are stored as plain 2048-byte sectors, so the .mdf already is an ISO and is
+// read in place. CD-style images keep raw 2352- or 2448-byte sectors (sync,
+// header, EDC/ECC, optional subchannel) and are converted to a temporary ISO.
+bool IsMdsMdfPath(const std::string& s)
+{
+  return HasExtensionICase(s, ".mds") || HasExtensionICase(s, ".mdf");
+}
+
+static bool FileExists(const std::string& path)
+{
+  FILE* fp = fopen(path.c_str(), "rb");
+  if (!fp) return false;
+  fclose(fp);
+  return true;
+}
+
+// game.mds -> game.mdf (the extension's case varies between rippers)
+static std::string MdfForMds(const std::string& mds)
+{
+  const std::string base = mds.substr(0, mds.size() - 4);
+  static const char* exts[] = { ".mdf", ".MDF", ".Mdf", nullptr };
+  for (const char** e = exts; *e; e++)
+    if (FileExists(base + *e)) return base + *e;
+  return std::string();
+}
+
+// Finds where each sector's 2048 bytes of user data sit by looking for the
+// volume recognition area at sector 16: ISO 9660 "CD001" or UDF "BEA01".
+static bool ProbeMdfLayout(FILE* fp, uint32_t& sectorSize, uint32_t& dataOffset)
+{
+  static const uint32_t layouts[][2] = {
+    { 2048, 0 },             // DVD, or a CD image stored as user data only
+    { 2352, 16 }, { 2352, 24 }, // raw CD: Mode 1 / Mode 2 Form 1
+    { 2448, 16 }, { 2448, 24 }, // raw CD + 96 bytes of subchannel
+  };
+  for (const auto& l : layouts) {
+    unsigned char id[6];
+    if (ISO_FSEEK(fp, (uint64_t)16 * l[0] + l[1], SEEK_SET) != 0) continue;
+    if (fread(id, 1, 6, fp) != 6) continue;
+    if (memcmp(id + 1, "CD001", 5) == 0 || memcmp(id + 1, "BEA01", 5) == 0) {
+      sectorSize = l[0];
+      dataOffset = l[1];
+      return true;
+    }
+  }
+  return false;
+}
+
+// Returns the .mdf itself when it is already a 2048-byte-sector image,
+// otherwise <tempDir>/extracted.iso holding just the user data. "" on failure.
+std::string MdfToIso(const char* mdfPath, const std::string& tempDir)
+{
+  FILE* in = fopen(mdfPath, "rb");
+  if (!in) {
+    fprintf(stderr, "Cannot open %s\n", mdfPath);
+    return std::string();
+  }
+  uint32_t sectorSize = 0, dataOffset = 0;
+  if (!ProbeMdfLayout(in, sectorSize, dataOffset)) {
+    fprintf(stderr, "%s is not a recognisable disc image (no ISO 9660 or UDF volume found)\n", mdfPath);
+    fclose(in);
+    return std::string();
+  }
+  if (sectorSize == 2048) {
+    fclose(in);
+    return std::string(mdfPath);
+  }
+
+  const std::string isoPath = tempDir + PATH_SEP + "extracted.iso";
+  FILE* out = fopen(isoPath.c_str(), "wb");
+  if (!out) {
+    fprintf(stderr, "Cannot create %s\n", isoPath.c_str());
+    fclose(in);
+    return std::string();
+  }
+  ISO_FSEEK(in, 0, SEEK_SET);
+  std::vector<unsigned char> sector(sectorSize);
+  uint64_t sectors = 0;
+  while (fread(sector.data(), 1, sectorSize, in) == sectorSize) {
+    if (fwrite(sector.data() + dataOffset, 1, 2048, out) != 2048) {
+      fprintf(stderr, "Short write to %s\n", isoPath.c_str());
+      fclose(out);
+      fclose(in);
+      return std::string();
+    }
+    sectors++;
+  }
+  fclose(out);
+  fclose(in);
+  fprintf(stderr, "Converted MDF: %s (%u-byte sectors) -> %s (%llu sectors)\n",
+          mdfPath, sectorSize, isoPath.c_str(), (unsigned long long)sectors);
+  return isoPath;
+}
