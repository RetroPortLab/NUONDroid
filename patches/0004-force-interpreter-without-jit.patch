diff --git a/src/NuonEnvironment.cpp b/src/NuonEnvironment.cpp
index afaab8d..6a39503 100644
--- a/src/NuonEnvironment.cpp
+++ b/src/NuonEnvironment.cpp
@@ -1056,7 +1056,12 @@ bool NuonEnvironment::LoadConfigFile(const std::string& fileName)
 #endif
         }
 
-#if defined(_WIN64) && !defined(USE_ASMJIT) // 64-bit Windows builds without asmjit cannot generate native x64 code, so force interpreter
+#if !defined(USE_ASMJIT) && (defined(_WIN64) || defined(__x86_64__) || defined(__aarch64__) || defined(_M_ARM64) || defined(__arm__))
+        // No native code emitter for this target (64-bit x86 without asmjit, or
+        // ARM), so force the per-packet interpreter whatever nuance.cfg says.
+        // With [DynamicCompiler] Enabled these builds fall into the IL block
+        // path, which stalls the emulated MPEs: nuontest freezes at
+        // "testing in" and games boot to a black screen with no sound.
         compilerOptions.bAllowCompile = false;
 #endif
         break;
