+// Frame counter for a frontend's FPS display: bumped whenever the game points
+// the main video channel at a (new) frame - VidChangeBase on the main channel,
+// or a VidConfig with a main channel. How fast this moves is the game's own
+// frame rate, which a slow emulation lowers even though the core still hands
+// over a frame every 1/60 s.
+extern "C" volatile uint32 nuance_video_flips = 0;
+
 void VidQueryConfig(MPE &mpe)
 {
   VidDisplay * const displayStruct = (VidDisplay *)nuonEnv.GetPointerToMemory(mpe.mpeIndex, mpe.regs[0]);
@@ -1078,6 +1085,8 @@ void VidConfig(MPE &mpe)
 {
   const uint32 display_addr = mpe.regs[0];
   const uint32 main = mpe.regs[1];
+  if(main)
+    nuance_video_flips = nuance_video_flips + 1;
   const uint32 osd = mpe.regs[2];
   //const uint32 reserved = mpe.regs[3];
 
@@ -1507,6 +1516,7 @@ void VidChangeBase(MPE &mpe)
     switch(which)
     {
       case VID_CHANNEL_MAIN:
+        nuance_video_flips = nuance_video_flips + 1;
         //valid channel, set dmaflags and base then return 1
         structMainChannel.dmaflags = dmaflags;
         structMainChannel.base = base;
